# -----------------------------------------------------------------------------
# TradeSphere Environment Configuration
# -----------------------------------------------------------------------------

# Environment
NODE_ENV=development
APP_NAME=TradeSphere
APP_URL=http://localhost:3000

# Primary Relational Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://tradesphere:tradesphere_secret_dev@localhost:5432/tradesphere_db?schema=public"

# Redis (Caching, Rate Limiting, BullMQ Async Tasks)
REDIS_URL="redis://localhost:6379"

# Authentication Secrets
# Generate random key: openssl rand -base64 32
NEXTAUTH_SECRET="tradesphere_dev_super_secret_jwt_key_32chars_minimum"
NEXTAUTH_URL="http://localhost:3000"
JWT_EXPIRATION="7d"

# Storage Service (S3-compatible or local dev fallback)
STORAGE_PROVIDER="local" # "s3" or "local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="tradesphere-storage"
AWS_S3_ENDPOINT="" # Optional for MinIO / Cloudflare R2

# Payment Providers
PAYMENT_MOCK_ENABLED="true" # Always true for automated testing and local sandbox
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLIC_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASS=""
SSLCOMMERZ_IS_SANDBOX="true"

# Logistics & Shipping
SHIPPING_PROVIDER="simulator" # "simulator", "easypost", "shipengine"
EASYPOST_API_KEY=""

# Email Notifications
EMAIL_PROVIDER="console" # "console", "resend", "smtp"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="TradeSphere <notifications@tradesphere.local>"

# Currency & Locale
DEFAULT_CURRENCY="USD"
SUPPORTED_CURRENCIES="USD,EUR,GBP,BDT,CNY,INR,JPY"
