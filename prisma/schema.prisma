// This is the Prisma schema for TradeSphere B2B & B2C Marketplace
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  GUEST
  BUYER
  BUSINESS_BUYER
  SELLER
  SELLER_STAFF
  SUPPLIER
  LOGISTICS_PARTNER
  CUSTOMER_SUPPORT
  CONTENT_MODERATOR
  FINANCE_OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PaymentProvider {
  MOCK_DEVELOPMENT
  STRIPE
  SSLCOMMERZ
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  QUOTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
}

enum QuotationStatus {
  OFFERED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  RESERVED
  RELEASED
  ADJUSTMENT
  RETURN
}

enum LedgerEntryType {
  CREDIT // e.g. seller earnings
  DEBIT  // e.g. payout, platform fee, refund
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED_REFUND
  RESOLVED_NO_REFUND
  CLOSED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// -----------------------------------------------------------------------------
// Identity & Organizations
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  role          UserRole  @default(BUYER)
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships        OrganizationMembership[]
  sellerProfile      SellerProfile?
  addresses          Address[]
  buyerOrders        Order[]
  rfqs               RFQ[]
  sentMessages       NegotiationMessage[]
  reviews            Review[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  reportsFiled       Report[]
  conversationsBuyer Conversation[]           @relation("BuyerConversations")
  wishlistItems      WishlistItem[]

  @@index([email])
  @@index([role])
}

model Organization {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  taxId         String?
  legalName     String?
  website       String?
  country       String    @default("US")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   OrganizationMembership[]
  sellerProfile SellerProfile?
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleInOrg      String       @default("MEMBER") // OWNER, ADMIN, MEMBER, PROCUREMENT
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// -----------------------------------------------------------------------------
// Multi-Vendor Seller Profiles & Trust
// -----------------------------------------------------------------------------

model SellerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  organizationId     String?            @unique
  storeName          String             @unique
  storeSlug          String             @unique
  description        String?
  logoUrl            String?
  bannerUrl          String?
  businessAddress    String?
  city               String?
  country            String             @default("US")
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  taxRegistrationNo  String?
  tradeLicenseUrl    String?
  commissionRate     Decimal            @default(5.00) @db.Decimal(5, 2) // percentage
  availableBalance   Decimal            @default(0.00) @db.Decimal(12, 2)
  pendingBalance     Decimal            @default(0.00) @db.Decimal(12, 2)
  isSuspended        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  products           Product[]
  orders             Order[]
  quotations         Quotation[]
  ledgerEntries      LedgerEntry[]
  settlements        Settlement[]
  conversations      Conversation[]     @relation("SellerConversations")
  reviews            Review[]

  @@index([storeSlug])
  @@index([verificationStatus])
}

// -----------------------------------------------------------------------------
// Catalog, Brands & Categories
// -----------------------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  rfqs        RFQ[]

  @@index([slug])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  website     String?
  createdAt   DateTime  @default(now())
  products    Product[]

  @@index([slug])
}

// -----------------------------------------------------------------------------
// Products, Variants & B2B Wholesale Pricing
// -----------------------------------------------------------------------------

model Product {
  id                    String         @id @default(uuid())
  sellerId              String
  categoryId            String
  brandId               String?
  name                  String
  slug                  String         @unique
  description           String
  specifications        Json?          // Key-value specifications
  countryOfOrigin       String         @default("US")
  status                ProductStatus  @default(PENDING_REVIEW)
  moderationNotes       String?
  
  // Pricing & B2B Wholesale Rules
  basePrice             Decimal        @db.Decimal(12, 2) // Retail / starting price
  moq                   Int            @default(1)        // Minimum Order Quantity
  maxOrderQuantity      Int?
  leadTimeDays          Int            @default(3)
  productionCapacity    String?        // e.g. "10,000 units / month"
  sampleAvailable       Boolean        @default(false)
  samplePrice           Decimal?       @db.Decimal(12, 2)
  customizationAvailable Boolean       @default(false)
  packageDimensions     Json?          // { weightKg, lengthCm, widthCm, heightCm }
  
  isFeatured            Boolean        @default(false)
  ratingAverage         Decimal        @default(0.00) @db.Decimal(3, 2)
  reviewCount           Int            @default(0)
  salesCount            Int            @default(0)
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  seller                SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category              Category       @relation(fields: [categoryId], references: [id])
  brand                 Brand?         @relation(fields: [brandId], references: [id])
  variants              ProductVariant[]
  priceTiers            PriceTier[]    // Volume discount tiers
  media                 ProductMedia[]
  orderItems            OrderItem[]
  reviews               Review[]
  wishlistItems         WishlistItem[]

  @@index([slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([basePrice])
  @@index([moq])
}

model ProductVariant {
  id          String      @id @default(uuid())
  productId   String
  sku         String      @unique
  title       String      // e.g. "Matte Black / Large / 100W"
  price       Decimal     @db.Decimal(12, 2)
  attributes  Json        // { "Color": "Black", "Size": "L" }
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?
  orderItems  OrderItem[]

  @@index([sku])
  @@index([productId])
}

// B2B Tiered Pricing (Volume discounts)
model PriceTier {
  id          String   @id @default(uuid())
  productId   String
  minQuantity Int
  maxQuantity Int?     // null means and above
  unitPrice   Decimal  @db.Decimal(12, 2)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@unique([productId, minQuantity])
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// -----------------------------------------------------------------------------
// Inventory & Stock Movements
// -----------------------------------------------------------------------------

model Inventory {
  id             String          @id @default(uuid())
  variantId      String          @unique
  availableStock Int             @default(0)
  reservedStock  Int             @default(0)
  lowStockAlert  Int             @default(10)
  updatedAt      DateTime        @updatedAt

  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([variantId])
}

model StockMovement {
  id          String            @id @default(uuid())
  inventoryId String
  quantity    Int
  type        StockMovementType
  referenceId String?           // Order ID, Adjustment ID, or Inbound Batch
  reason      String?
  createdAt   DateTime          @default(now())

  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
}

// -----------------------------------------------------------------------------
// Cart, Wishlist & Addresses
// -----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  fullName     String
  companyName  String?
  street       String
  apartment    String?
  city         String
  state        String
  postalCode   String
  country      String   @default("US")
  phone        String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
}

// -----------------------------------------------------------------------------
// B2B Wholesale RFQ & Negotiation Engine
// -----------------------------------------------------------------------------

model RFQ {
  id                 String               @id @default(uuid())
  buyerId            String
  rfqNumber          String               @unique
  title              String
  categoryId         String
  quantity           Int
  targetPrice        Decimal?             @db.Decimal(12, 2)
  destinationCountry String
  specifications     String
  deliveryDate       DateTime?
  status             RFQStatus            @default(SUBMITTED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  buyer              User                 @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  category           Category             @relation(fields: [categoryId], references: [id])
  quotations         Quotation[]
  messages           NegotiationMessage[]

  @@index([buyerId])
  @@index([status])
}

model Quotation {
  id           String               @id @default(uuid())
  rfqId        String
  sellerId     String
  quoteNumber  String               @unique
  unitPrice    Decimal              @db.Decimal(12, 2)
  totalPrice   Decimal              @db.Decimal(12, 2)
  minQuantity  Int                  @default(1)
  leadTimeDays Int                  @default(7)
  validUntil   DateTime
  terms        String?
  status       QuotationStatus      @default(OFFERED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  rfq          RFQ                  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller       SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages     NegotiationMessage[]

  @@index([rfqId])
  @@index([sellerId])
}

model NegotiationMessage {
  id               String     @id @default(uuid())
  rfqId            String?
  quotationId      String?
  senderId         String
  senderRole       String     // "BUYER" or "SELLER"
  message          String
  proposedPrice    Decimal?   @db.Decimal(12, 2)
  proposedQuantity Int?
  createdAt        DateTime   @default(now())

  rfq              RFQ?       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation        Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sender           User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([quotationId])
}

// -----------------------------------------------------------------------------
// Orders, Checkout & Fulfillment
// -----------------------------------------------------------------------------

model Order {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique
  buyerId            String
  sellerId           String
  shippingAddressId  String?
  currency           String               @default("USD")
  
  // Amounts calculated strictly on server
  subtotal           Decimal              @db.Decimal(12, 2)
  discount           Decimal              @default(0.00) @db.Decimal(12, 2)
  tax                Decimal              @default(0.00) @db.Decimal(12, 2)
  shippingFee        Decimal              @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal              @db.Decimal(12, 2)
  
  status             OrderStatus          @default(PENDING)
  paymentStatus      PaymentStatus        @default(UNPAID)
  isB2BTradeAssurance Boolean             @default(false)
  notes              String?
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Relations
  buyer              User                 @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  seller             SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shippingAddress    Address?             @relation(fields: [shippingAddressId], references: [id])
  items              OrderItem[]
  shipments          Shipment[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  refunds            Refund[]
  disputes           Dispute[]
  ledgerEntries      LedgerEntry[]

  @@index([orderNumber])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

// Immutable snapshot of product state at time of purchase
model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  productName String
  sku         String
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal         @db.Decimal(12, 2)
  metadata    Json?           // Attributes, tier info, specs snapshot

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id             String      @id @default(uuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  changedBy      String?     // user id or SYSTEM
  createdAt      DateTime    @default(now())

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shipment {
  id                 String         @id @default(uuid())
  orderId            String
  carrier            String         // e.g. "DHL Express", "FedEx", "TradeSphere Logistics"
  trackingNumber     String?
  status             ShipmentStatus @default(PENDING)
  dispatchedAt       DateTime?
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  trackingUrl        String?
  shippingLabelUrl   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
}

// -----------------------------------------------------------------------------
// Payments & Financial Ledger
// -----------------------------------------------------------------------------

model Payment {
  id            String          @id @default(uuid())
  orderId       String
  provider      PaymentProvider
  transactionId String?         @unique
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("USD")
  status        PaymentStatus   @default(PENDING)
  rawResponse   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds       Refund[]

  @@index([orderId])
  @@index([transactionId])
}

model Refund {
  id        String   @id @default(uuid())
  orderId   String
  paymentId String?
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  status    String   @default("COMPLETED") // PENDING, COMPLETED, REJECTED
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
}

// Double-entry / balanced financial ledger
model LedgerEntry {
  id           String          @id @default(uuid())
  sellerId     String
  orderId      String?
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2)
  feeAmount    Decimal         @default(0.00) @db.Decimal(12, 2)
  netAmount    Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  description  String
  createdAt    DateTime        @default(now())

  seller       SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order        Order?          @relation(fields: [orderId], references: [id])

  @@index([sellerId])
  @@index([orderId])
}

model Settlement {
  id           String           @id @default(uuid())
  sellerId     String
  amount       Decimal          @db.Decimal(12, 2)
  status       SettlementStatus @default(PENDING)
  payoutMethod String           // "BANK_TRANSFER", "STRIPE_CONNECT", "SSLCOMMERZ"
  reference    String?
  requestedAt  DateTime         @default(now())
  processedAt  DateTime?

  seller       SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

// -----------------------------------------------------------------------------
// Messaging & Notifications
// -----------------------------------------------------------------------------

model Conversation {
  id        String    @id @default(uuid())
  buyerId   String
  sellerId  String
  subject   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  buyer     User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    SellerProfile @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachments    Json?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Trust, Safety, Reviews & Disputes
// -----------------------------------------------------------------------------

model Review {
  id                 String        @id @default(uuid())
  userId             String
  productId          String
  sellerId           String
  rating             Int           // 1 to 5
  comment            String
  isVerifiedPurchase Boolean       @default(false)
  isApproved         Boolean       @default(true)
  createdAt          DateTime      @default(now())

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([sellerId])
}

model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  targetType String   // "PRODUCT", "SELLER", "REVIEW"
  targetId   String
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
}

// -----------------------------------------------------------------------------
// Marketing & Promotions
// -----------------------------------------------------------------------------

model Coupon {
  id             String      @id @default(uuid())
  code           String      @unique
  type           CouponType  @default(PERCENTAGE)
  discountValue  Decimal     @db.Decimal(12, 2)
  minOrderValue  Decimal?    @db.Decimal(12, 2)
  maxDiscount    Decimal?    @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int         @default(0)
  isActive       Boolean     @default(true)
  startsAt       DateTime    @default(now())
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())

  @@index([code])
}

// -----------------------------------------------------------------------------
// Audit Logs
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "USER_LOGIN", "SELLER_VERIFIED", "ORDER_STATUS_CHANGED"
  resource   String   // e.g. "Order", "SellerProfile", "User"
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
}
